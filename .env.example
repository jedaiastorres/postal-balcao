PORT=3000
NODE_ENV=development
CONECTENVIOS_API_URL=https://app.conectenvios.com.br/api/v1
CONECTENVIOS_TOKEN=
POSTAL_MARKUP_PERCENT=8
PARTNER_COMMISSION_PERCENT=10
APP_USER=
APP_PASSWORD=
APP_SESSION_SECRET=
APP_DEMO_AUTH=false
ENABLE_SHIPMENT_CREATION=false

# Comprovante termico: 80 ou 58 mm
THERMAL_RECEIPT_WIDTH_MM=80


# Banco de dados
DATABASE_URL=

# Asaas (comece em Sandbox)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
APP_PUBLIC_URL=http://localhost:3000

# Taxas padrão usadas para proteger as margens no checkout.
# Ajuste para as condições comerciais reais da conta Asaas.
ASAAS_PIX_FEE_FIXED=1.99
ASAAS_CARD_FEE_PERCENT=2.99
ASAAS_CARD_FEE_FIXED=0.49

# Wallet do ponto piloto. Em produção, cada ponto deve ter sua própria wallet no banco.
ASAAS_DEFAULT_PARTNER_WALLET_ID=

# Opcional: wallet separada para reservar o custo ConectEnvios.
# Se a ConectEnvios fornecer uma wallet Asaas própria, use-a aqui.
ASAAS_CONNECTENVIOS_RESERVE_WALLET_ID=

# API versionada para integrar novos produtos, serviços e parceiros externos
INTEGRATION_API_KEY=

# Homologacao financeira enquanto Asaas nao estiver ativo
PAYMENT_SIMULATOR_ENABLED=true
